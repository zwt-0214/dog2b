Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 0.2
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: false
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: true
      Alpha: 0.35
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: E3MarkerLegacy
      Marker Topic:
        Value: /dhz_4/e3_marker
      Queue Size: 100
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: SceneObjectTruthMarkers
      Marker Topic:
        Value: /lite_motion_planner/collision_markers
      Namespaces:
        attached_collision: true
        attached_collision_origin: true
        attached_collision_label: true
        scene_collision: true
        scene_collision_origin: true
        scene_collision_label: true
      Queue Size: 10
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: ReferenceFrames
      Marker Topic:
        Value: /dhz_4/reference_frames
      Namespaces:
        arc7_center: true
        arc7_center_label: true
        arc8_center: true
        arc8_center_label: true
        camera_right_link_axis: true
        camera_right_link_label: true
        d_test_axis: true
        d_test_label: true
        d_test_frozen_axis: true
        d_test_frozen_label: true
        d_test_live_axis: true
        d_test_live_label: true
        d_test_pre_pos_z_axis: true
        d_test_pre_pos_z_label: true
        right_ccb_axis: true
        right_ccb_label: true
        right_tcp_axis: true
        right_tcp_label: true
        zc_f_axis: true
        zc_f_label: true
        zc_l_axis: true
        zc_l_label: true
        zc_m_axis: true
        zc_m_label: true
        zc_r_axis: true
        zc_r_label: true
      Queue Size: 10
    - Class: moveit_rviz_plugin/MotionPlanning
      Enabled: false
      Name: MotionPlanningLegacy
      Move Group Namespace: ""
      Planned Path:
        Trajectory Topic: /display_planned_path
        Show Robot Visual: true
      Planning Scene Topic: /monitored_planning_scene
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 1
        Scene Color: 50; 230; 50
      Scene Robot:
        Show Robot Visual: true
      Planning Request:
        Planning Group: right_arm
        Query Goal State: false
        Query Start State: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.5
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1400
